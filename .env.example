# --- Milestone 1B: real baseline (Postgres + Auth.js) ---
# Copy to .env and fill in values. Required when USE_MOCK_DATA is not true.

# Vercel Postgres / Neon connection string
POSTGRES_URL=

# Auth.js — required for real baseline
# Local dev: http://localhost:3000
# Vercel: https://your-deployment.vercel.app (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# Generate at https://generate-secret.vercel.app/32
AUTH_SECRET=

# GitHub OAuth — https://github.com/settings/developers
# Callback URL: {NEXTAUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Local dev only: skip Postgres/Auth requirements ---
# USE_MOCK_DATA=true
